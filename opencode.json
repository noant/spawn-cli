{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mempalace-mcp": {
      "type": "local",
      "command": [
        "spawn",
        "mcp_stdio",
        "extension",
        "mempalace-ext",
        "name",
        "mempalace-mcp"
      ],
      "enabled": true,
      "environment": {
        "MEMPALACE_PALACE_PATH": ".mempalace/palace"
      }
    },
    "mempalace-mine-mcp": {
      "type": "local",
      "command": [
        "spawn",
        "mcp_stdio",
        "extension",
        "mempalace-ext",
        "name",
        "mempalace-mine-mcp"
      ],
      "enabled": true,
      "environment": {
        "MEMPALACE_PALACE_PATH": ".mempalace/palace"
      }
    }
  }
}